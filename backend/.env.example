# ── App ──
APP_ENV=development
SECRET_KEY=change-me-to-a-random-string
ALLOWED_ORIGINS=http://localhost:3000

# ── Database ──
DATABASE_URL=postgresql+asyncpg://interviewpal:localdev@localhost:5433/interviewpal

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── AI ──
ANTHROPIC_API_KEY=your-key-here
OPENAI_API_KEY=your-key-here

# ── AWS S3 ──
AWS_ACCESS_KEY_ID=your-key-here
AWS_SECRET_ACCESS_KEY=your-secret-here
AWS_S3_BUCKET=interviewpal-recordings
AWS_REGION=us-west-2

# ── Email (Gmail SMTP) ──
# Set MAIL_ENABLED=true and fill in your Gmail credentials to send session summaries
MAIL_ENABLED=false
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=your-gmail@gmail.com
MAIL_FROM_NAME=InterviewPal

# ── JWT ──
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
